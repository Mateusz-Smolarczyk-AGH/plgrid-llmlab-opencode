# CyfroCode environment variables
# Copy to .env and fill in the values.

# PLGrid Forge API key (required)
# Generate at: https://llmlab.plgrid.pl -> Grants -> Generate API Key
PLGRID_API_KEY=plg-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Context7 API key (optional; raises MCP rate limits)
CONTEXT7_API_KEY=

# SSH key for HPC access (optional; only used with docker-compose.ssh.yml)
# SSH_KEY_PATH=~/.ssh/id_ed25519

# System
TIMEZONE=Europe/Warsaw
