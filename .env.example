# CyfroCode environment variables
# Copy to .env and fill in the values.
#
# This file is mounted into the container as the Docker secret
# /run/secrets/cyfrocode_env. It is NOT injected into the container's environment,
# so `docker exec` sessions and the agent never inherit its values. Only the
# entrypoint reads it, once, to seed PLGrid auth.

# PLGrid Forge API key (required)
# Read once at container start to seed ~/.local/share/opencode/auth.json, then
# discarded. Generate at: https://llmlab.plgrid.pl -> Grants -> Generate API Key
PLGRID_API_KEY=plg-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Context7 API key (optional; raises MCP rate limits)
CONTEXT7_API_KEY=

# System
TIMEZONE=Europe/Warsaw
